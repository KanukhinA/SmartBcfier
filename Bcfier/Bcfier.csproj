<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatAsLocalProperty>Platform</TreatAsLocalProperty>
    <Platform Condition="'$(Platform)' == 'Any CPU' Or '$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>Bcfier</RootNamespace>
    <AssemblyName>Bcfier</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyVersionInfo.cs" Link="AssemblyVersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="gong-wpf-dragdrop" Version="1.1.0">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Api\**" />
    <Compile Remove="UserControls\IssuesPanel.xaml.cs" />
    <Page Remove="UserControls\IssuesPanel.xaml" />
    <None Remove="packages.config" />
    <None Remove="App.config" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\SP_BCFier16.png" />
    <Resource Include="Assets\SP_BCFier32.png" />
    <Resource Include="Assets\BCFierIcon16x16.png" />
    <Resource Include="Assets\BCFierIcon32x32.png" />
    <Resource Include="Assets\BCFierIcon64x64.png" />
    <EmbeddedResource Include="Assets\SP_BCFier16.png" LogicalName="Bcfier.Assets.SP_BCFier16.png" />
    <EmbeddedResource Include="Assets\SP_BCFier32.png" LogicalName="Bcfier.Assets.SP_BCFier32.png" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>
</Project>
