<Window
  x:Class="Bcfier.Windows.ExcelImportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  Title="{x:Static loc:Loc.ExcelImportTitle}"
  Width="980"
  MinWidth="760"
  Height="640"
  MinHeight="480"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ReportTableStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ChromeOuter" Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{x:Static loc:Loc.ExcelImportTitle}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="HeaderClose_Click"
              AutomationProperties.Name="{x:Static loc:Loc.Close}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="{StaticResource SpSpace.ContentInset}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" MinHeight="160" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <CheckBox
              x:Name="HasHeaderCheck"
              DockPanel.Dock="Right"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Content="{x:Static loc:Loc.ExcelImportHasHeaderRow}"
              Checked="Options_Changed"
              Unchecked="Options_Changed" />
            <TextBlock
              DockPanel.Dock="Left"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Text="{x:Static loc:Loc.ExcelImportSheet}" />
            <ComboBox
              x:Name="SheetCombo"
              MinHeight="28"
              Style="{StaticResource SpComboBox}"
              SelectionChanged="SheetCombo_SelectionChanged" />
          </DockPanel>

          <Border
            Grid.Row="1"
            Background="{StaticResource SpBrush.Card}"
            BorderBrush="{StaticResource SpBrush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource SpRadius.Card}"
            Padding="1"
            SnapsToDevicePixels="True">
            <Grid>
              <TextBlock
                x:Name="PreviewError"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{StaticResource SpBrush.Muted}"
                Visibility="Collapsed" />
              <DataGrid
                x:Name="PreviewGrid"
                Style="{StaticResource SpReportDataGrid}"
                BorderThickness="0"
                HeadersVisibility="Column"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                SelectionMode="Single"
                SelectionUnit="Cell" />
            </Grid>
          </Border>

          <TextBlock
            Grid.Row="2"
            Margin="0,12,0,6"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Text="{x:Static loc:Loc.ExcelImportMappingHint}" />

          <Border
            Grid.Row="3"
            Background="{StaticResource SpBrush.Card}"
            BorderBrush="{StaticResource SpBrush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource SpRadius.Card}"
            Padding="8"
            SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="MappingList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding FieldName}" />
                      <ComboBox
                        Grid.Column="1"
                        MinHeight="26"
                        Style="{StaticResource SpComboBox}"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Index"
                        ItemsSource="{Binding DataContext.ColumnOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValue="{Binding SelectedColumnIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <DockPanel LastChildFill="False">
            <TextBlock
              x:Name="StatusText"
              DockPanel.Dock="Left"
              VerticalAlignment="Center"
              Foreground="{StaticResource SpBrush.Muted}"
              TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button
                MinWidth="100"
                Style="{StaticResource SpSecondaryButton}"
                Content="{x:Static loc:Loc.Cancel}"
                Click="Cancel_Click"
                IsCancel="True" />
              <Button
                x:Name="ImportBtn"
                MinWidth="120"
                Margin="8,0,0,0"
                Style="{StaticResource SpAccentButton}"
                Content="{x:Static loc:Loc.ExcelImport}"
                Click="Import_Click"
                IsDefault="True" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
