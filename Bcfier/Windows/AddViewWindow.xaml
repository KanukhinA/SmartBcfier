<Window
  x:Class="Bcfier.Windows.AddViewWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctr="clr-namespace:Bcfier.UserControls"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  Title="{x:Static loc:Loc.AddView}"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  Width="480"
  Height="520"
  MinWidth="400"
  MinHeight="420"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="AddViewWindow_OnLoaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border
    x:Name="ChromeOuter"
    Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="HeaderTitle"
              Text="{x:Static loc:Loc.AddView}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              VerticalAlignment="Center"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="HeaderClose_Click"
              AutomationProperties.Name="Закрыть" />
          </Grid>
        </Border>

        <ScrollViewer
          Grid.Row="1"
          Margin="{StaticResource SpSpace.ContentInset}"
          VerticalScrollBarVisibility="Auto">
          <ctr:AddView
            x:Name="AddViewControl"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" />
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
              MinWidth="100"
              Margin="0,0,8,0"
              Padding="10,4"
              Style="{StaticResource SpAccentButton}"
              Content="{x:Static loc:Loc.Add}"
              IsDefault="True"
              Click="FooterAdd_Click" />
            <Button
              MinWidth="100"
              Padding="10,4"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.Cancel}"
              IsCancel="True"
              Click="FooterCancel_Click" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
