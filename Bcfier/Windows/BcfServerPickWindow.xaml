<Window
  x:Class="Bcfier.Windows.BcfServerPickWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  Title="{x:Static loc:Loc.SpServicePickTitle}"
  Width="560"
  MinWidth="400"
  Height="460"
  MinHeight="320"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ChromeOuter" Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{x:Static loc:Loc.SpServicePickTitle}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="HeaderClose_Click"
              AutomationProperties.Name="Закрыть" />
          </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="{StaticResource SpSpace.ContentInset}">
          <TextBlock
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Text="{x:Static loc:Loc.SpServicePickHint}" />
          <ListBox
            x:Name="FilesList"
            DisplayMemberPath="DisplayName"
            MouseDoubleClick="FilesList_MouseDoubleClick" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
              MinWidth="100"
              Margin="0,0,8,0"
              Padding="10,4"
              Style="{StaticResource SpAccentButton}"
              Click="OpenButton_Click"
              Content="{x:Static loc:Loc.OpenBcf}"
              IsDefault="True" />
            <Button
              MinWidth="100"
              Padding="10,4"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.Cancel}"
              IsCancel="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
