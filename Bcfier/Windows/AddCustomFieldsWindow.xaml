<Window
  x:Class="Bcfier.Windows.AddCustomFieldsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  xmlns:src="clr-namespace:Bcfier.Data.ValueConverters"
  Title="{x:Static loc:Loc.CustomFieldsManageTitle}"
  Width="520"
  MinWidth="420"
  Height="420"
  MinHeight="320"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <src:BoolVisibConverter x:Key="BoolVisibConverter" />
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ChromeOuter" Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{x:Static loc:Loc.CustomFieldsManageTitle}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="HeaderClose_Click"
              AutomationProperties.Name="{x:Static loc:Loc.Close}" />
          </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="{StaticResource SpSpace.ContentInset}">
          <TextBlock
            x:Name="HintText"
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Text="{x:Static loc:Loc.CustomFieldsAddHint}" />
          <TextBlock
            x:Name="EmptyHint"
            DockPanel.Dock="Top"
            Margin="0,12,0,0"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Text="{x:Static loc:Loc.CustomFieldsNoDefinitions}" />
          <ListBox x:Name="FieldsList" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox
                  Margin="0,4"
                  VerticalContentAlignment="Center"
                  Content="{Binding Name}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
              MinWidth="100"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.Cancel}"
              Click="Cancel_Click"
              IsCancel="True" />
            <Button
              x:Name="OkButton"
              MinWidth="100"
              Margin="8,0,0,0"
              Style="{StaticResource SpAccentButton}"
              Content="{x:Static loc:Loc.Save}"
              Click="Ok_Click"
              IsDefault="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
