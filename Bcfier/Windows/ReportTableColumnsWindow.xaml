<Window
  x:Class="Bcfier.Windows.ReportTableColumnsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  xmlns:rt="clr-namespace:Bcfier.ReportTable"
  xmlns:src="clr-namespace:Bcfier.Data.ValueConverters"
  xmlns:themes="clr-namespace:Bcfier.Themes"
  Title="{x:Static loc:Loc.TableColumnsTitle}"
  Width="760"
  MinWidth="640"
  Height="640"
  MinHeight="480"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <src:BoolVisibConverter x:Key="BoolVisibConverter" />
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ChromeOuter" Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{x:Static loc:Loc.TableColumnsTitle}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="HeaderClose_Click"
              AutomationProperties.Name="{x:Static loc:Loc.Close}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="{StaticResource SpSpace.ContentInset}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock
              FontWeight="SemiBold"
              Text="{x:Static loc:Loc.TableCommentGroupsTitle}" />
            <TextBlock
              Margin="0,4,0,0"
              Foreground="{StaticResource SpBrush.Muted}"
              TextWrapping="Wrap"
              Text="{x:Static loc:Loc.TableCommentGroupsHint}" />
          </StackPanel>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
              <UniformGrid
                DockPanel.Dock="Bottom"
                Margin="0,6,0,0"
                Columns="2"
                Rows="1">
                <Button
                  Margin="0,0,3,0"
                  Padding="8,3"
                  HorizontalAlignment="Stretch"
                  Style="{StaticResource SpSecondaryButton}"
                  Content="{x:Static loc:Loc.TableCommentAddGroup}"
                  Click="AddGroup_Click" />
                <Button
                  Margin="3,0,0,0"
                  Padding="8,3"
                  HorizontalAlignment="Stretch"
                  Style="{StaticResource SpSecondaryButton}"
                  Content="{x:Static loc:Loc.TableCommentDeleteGroup}"
                  Click="DeleteGroup_Click" />
              </UniformGrid>
              <ListBox
                x:Name="GroupsList"
                DisplayMemberPath="Name"
                SelectionChanged="GroupsList_SelectionChanged" />
            </DockPanel>
            <DockPanel Grid.Column="1">
              <TextBlock
                DockPanel.Dock="Top"
                Margin="0,0,0,4"
                Text="{x:Static loc:Loc.TableCommentGroupName}" />
              <TextBox
                x:Name="GroupNameBox"
                DockPanel.Dock="Top"
                MinHeight="28"
                Margin="0,0,0,8"
                Padding="0,3"
                VerticalContentAlignment="Center"
                Style="{StaticResource SpSettingsTextBox}"
                TextChanged="GroupNameBox_TextChanged" />
              <TextBlock
                DockPanel.Dock="Top"
                Margin="0,0,0,4"
                Text="{x:Static loc:Loc.TableCommentMembers}" />
              <ListBox x:Name="MembersList">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox
                      Content="{Binding Name}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Checked="MemberCheck_Changed"
                      Unchecked="MemberCheck_Changed" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>

          <TextBlock
            Grid.Row="2"
            Margin="0,12,0,6"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Text="{x:Static loc:Loc.TableColumnsHint}" />

          <DockPanel Grid.Row="3">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" MinWidth="100" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                MinWidth="20"
                FontWeight="SemiBold"
                Foreground="{StaticResource SpBrush.Muted}"
                Text="{x:Static loc:Loc.TableColumnVisibleHeader}" />
              <TextBlock
                Grid.Column="1"
                Margin="0,0,8,0"
                FontWeight="SemiBold"
                Foreground="{StaticResource SpBrush.Muted}"
                Text="{x:Static loc:Loc.TableColumnDefaultHeader}" />
              <TextBlock
                Grid.Column="2"
                Margin="0,0,8,0"
                FontWeight="SemiBold"
                Foreground="{StaticResource SpBrush.Muted}"
                Text="{x:Static loc:Loc.TableColumnCustomName}" />
              <TextBlock
                Grid.Column="3"
                FontWeight="SemiBold"
                Foreground="{StaticResource SpBrush.Muted}"
                Text="{x:Static loc:Loc.TableAlignColumn}" />
            </Grid>
            <ListBox
              x:Name="ColumnsList"
              SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" MinWidth="100" />
                      <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      IsChecked="{Binding Visible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      Text="{Binding DefaultHeader}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding DefaultHeader}" />
                    <TextBox
                      Grid.Column="2"
                      MinHeight="26"
                      Margin="0,0,8,0"
                      Padding="0,3"
                      VerticalContentAlignment="Center"
                      Style="{StaticResource SpSettingsTextBox}"
                      Tag="{x:Static loc:Loc.TableColumnCustomName}"
                      Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{x:Static loc:Loc.TableColumnCustomNameTip}" />
                    <ComboBox
                      Grid.Column="3"
                      MinHeight="26"
                      Style="{StaticResource SpSettingsComboBox}"
                      SelectedValue="{Binding TextAlign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag"
                      ToolTip="{x:Static loc:Loc.TableAlignColumn}">
                      <ComboBoxItem Content="{x:Static loc:Loc.TableAlignLeft}" Tag="{x:Static rt:ReportTableTextAlign.Left}" />
                      <ComboBoxItem Content="{x:Static loc:Loc.TableAlignCenter}" Tag="{x:Static rt:ReportTableTextAlign.Center}" />
                      <ComboBoxItem Content="{x:Static loc:Loc.TableAlignRight}" Tag="{x:Static rt:ReportTableTextAlign.Right}" />
                    </ComboBox>
                  </Grid>
                  <StackPanel
                    Margin="28,6,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding IsCommentColumn, Converter={StaticResource BoolVisibConverter}}">
                    <ComboBox
                      MinWidth="120"
                      MinHeight="26"
                      Margin="0,0,8,0"
                      Style="{StaticResource SpComboBox}"
                      SelectedValue="{Binding CommentScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag"
                      SelectionChanged="CommentScope_SelectionChanged">
                      <ComboBoxItem Content="{x:Static loc:Loc.TableCommentScopeAll}" Tag="{x:Static rt:ReportTableCommentScope.All}" />
                      <ComboBoxItem Content="{x:Static loc:Loc.TableCommentScopeUser}" Tag="{x:Static rt:ReportTableCommentScope.User}" />
                      <ComboBoxItem Content="{x:Static loc:Loc.TableCommentScopeGroup}" Tag="{x:Static rt:ReportTableCommentScope.Group}" />
                    </ComboBox>
                    <ComboBox
                      MinWidth="140"
                      MinHeight="26"
                      Margin="0,0,8,0"
                      Style="{StaticResource SpComboBox}"
                      IsEditable="True"
                      ItemsSource="{Binding DataContext.AuthorCandidates, RelativeSource={RelativeSource AncestorType=Window}}"
                      Text="{Binding CommentUser, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                      Visibility="{Binding IsCommentUserScope, Converter={StaticResource BoolVisibConverter}}" />
                    <ComboBox
                      MinWidth="160"
                      MinHeight="26"
                      Style="{StaticResource SpComboBox}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding CommentGroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Visibility="{Binding IsCommentGroupScope, Converter={StaticResource BoolVisibConverter}}" />
                    <themes:ButtonIcon
                      Style="{StaticResource OverlayIconButton}"
                      Width="26"
                      MinWidth="0"
                      Height="26"
                      IconSize="12"
                      IconPath="{StaticResource IconAdd}"
                      ToolTip="{x:Static loc:Loc.TableCommentDuplicateColumn}"
                      Click="DuplicateCommentColumn_Click" />
                    <themes:ButtonIcon
                      Margin="4,0,0,0"
                      Style="{StaticResource OverlayIconButton}"
                      Width="26"
                      MinWidth="0"
                      Height="26"
                      IconSize="12"
                      IconPath="{StaticResource IconDelete}"
                      ToolTip="{x:Static loc:Loc.TableCommentRemoveColumn}"
                      Click="RemoveCommentColumn_Click" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <StackPanel
            Grid.Row="4"
            Margin="0,8,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Left">
            <Button
              MinWidth="90"
              Padding="8,3"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.TableColumnMoveUp}"
              Click="MoveUp_Click" />
            <Button
              MinWidth="90"
              Margin="6,0,0,0"
              Padding="8,3"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.TableColumnMoveDown}"
              Click="MoveDown_Click" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
              MinWidth="100"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.Cancel}"
              Click="Cancel_Click"
              IsCancel="True" />
            <Button
              MinWidth="100"
              Margin="8,0,0,0"
              Style="{StaticResource SpAccentButton}"
              Content="{x:Static loc:Loc.Save}"
              Click="Save_Click"
              IsDefault="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
