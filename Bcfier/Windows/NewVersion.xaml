<Window
  x:Class="Bcfier.Windows.NewVersion"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  Title="{x:Static loc:Loc.NewVersionTitle}"
  MinWidth="300"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  SizeToContent="WidthAndHeight">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="14,10" Background="{StaticResource SpBrush.Surface}">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <TextBlock Name="Description" Margin="5" />
    <StackPanel
      Grid.Row="2"
      Margin="5,15,5,5"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        MinWidth="75"
        Margin="5"
        Padding="10,4"
        Style="{StaticResource SpAccentButton}"
        Click="Button_OK"
        Content="{x:Static loc:Loc.Yes}"
        IsDefault="True" />
      <Button
        MinWidth="100"
        Margin="5"
        Padding="10,4"
        Style="{StaticResource SpSecondaryButton}"
        Click="Button_Cancel"
        Content="{x:Static loc:Loc.MaybeLater}" />
    </StackPanel>
  </Grid>
</Window>
