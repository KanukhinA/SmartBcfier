<Window
  x:Class="Bcfier.Windows.ReportDocumentWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  Title="{x:Static loc:Loc.DocumentWindowTitle}"
  Width="720"
  MinWidth="560"
  Height="620"
  MinHeight="460"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ChromeOuter" Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{x:Static loc:Loc.DocumentWindowTitle}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="HeaderClose_Click"
              AutomationProperties.Name="{x:Static loc:Loc.Close}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="{StaticResource SpSpace.ContentInset}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Text="{x:Static loc:Loc.DocumentHint}" />

          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock
              Margin="0,0,0,4"
              FontWeight="SemiBold"
              Text="{x:Static loc:Loc.DocumentTitleLabel}" />
            <TextBox
              x:Name="TitleBox"
              MinHeight="28"
              Padding="0,3"
              VerticalContentAlignment="Center"
              Style="{StaticResource SpSettingsTextBox}"
              Tag="{x:Static loc:Loc.DocumentTitleHint}" />
            <TextBlock
              Margin="0,10,0,4"
              FontWeight="SemiBold"
              Text="{x:Static loc:Loc.DocumentSubtitleLabel}" />
            <TextBox
              x:Name="SubtitleBox"
              MinHeight="28"
              Padding="0,3"
              VerticalContentAlignment="Center"
              Style="{StaticResource SpSettingsTextBox}"
              Tag="{x:Static loc:Loc.DocumentSubtitleHint}" />
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,4,0,10">
            <CheckBox
              x:Name="ShowBlocksCheck"
              Content="{x:Static loc:Loc.DocumentShowFieldBlocks}" />
            <CheckBox
              x:Name="ShowNumbersCheck"
              Margin="0,6,0,0"
              Content="{x:Static loc:Loc.DocumentShowRowNumbers}" />
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock
              FontWeight="SemiBold"
              Text="{x:Static loc:Loc.DocumentFieldsTitle}" />
            <TextBlock
              Margin="0,4,0,0"
              Foreground="{StaticResource SpBrush.Muted}"
              TextWrapping="Wrap"
              Text="{x:Static loc:Loc.DocumentFieldsHint}" />
          </StackPanel>

          <DockPanel Grid.Row="4">
            <TextBlock
              x:Name="NoFieldsText"
              DockPanel.Dock="Top"
              Margin="0,0,0,8"
              Foreground="{StaticResource SpBrush.Muted}"
              TextWrapping="Wrap"
              Visibility="Collapsed"
              Text="{x:Static loc:Loc.DocumentNoFields}" />
            <DataGrid
              x:Name="FieldsList"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="False"
              CanUserResizeRows="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              GridLinesVisibility="Horizontal"
              Background="{StaticResource SpBrush.Field}"
              BorderBrush="{StaticResource SpBrush.Border}"
              BorderThickness="1"
              RowBackground="{StaticResource SpBrush.Field}"
              AlternatingRowBackground="{StaticResource SpBrush.Card}">
              <DataGrid.Columns>
                <DataGridTextColumn
                  Width="160"
                  MinWidth="120"
                  IsReadOnly="True"
                  Header="{x:Static loc:Loc.DocumentFieldName}"
                  Binding="{Binding DisplayName}" />
                <DataGridTemplateColumn
                  Width="*"
                  MinWidth="120"
                  Header="{x:Static loc:Loc.DocumentFieldValue}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        MinHeight="26"
                        Margin="2,1"
                        Padding="0,3"
                        VerticalContentAlignment="Top"
                        Style="{StaticResource SpSettingsTextBox}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MaxHeight="90"
                        VerticalScrollBarVisibility="Auto"
                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                  Width="150"
                  MinWidth="120"
                  Header="{x:Static loc:Loc.DocumentFieldSection}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox
                        MinHeight="26"
                        Margin="2,1"
                        Style="{StaticResource SpSettingsComboBox}"
                        IsEditable="True"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding DataContext.SectionSuggestions, RelativeSource={RelativeSource AncestorType=Window}}"
                        Text="{Binding Section, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                        ToolTip="{x:Static loc:Loc.DocumentFieldSection}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>

          <StackPanel
            Grid.Row="5"
            Margin="0,8,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Left">
            <Button
              MinWidth="90"
              Padding="8,3"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.TableColumnMoveUp}"
              Click="MoveUp_Click" />
            <Button
              MinWidth="90"
              Margin="6,0,0,0"
              Padding="8,3"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.TableColumnMoveDown}"
              Click="MoveDown_Click" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
              MinWidth="100"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.Cancel}"
              Click="Cancel_Click"
              IsCancel="True" />
            <Button
              MinWidth="100"
              Margin="8,0,0,0"
              Style="{StaticResource SpAccentButton}"
              Content="{x:Static loc:Loc.Save}"
              Click="Save_Click"
              IsDefault="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
