<Window
  x:Class="Bcfier.Windows.CustomFieldsPreviewWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  Title="{x:Static loc:Loc.CustomFieldsPreviewTitle}"
  Width="640"
  MinWidth="480"
  Height="420"
  MinHeight="300"
  Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
  FontFamily="{DynamicResource SpFont.Ui}"
  WindowStyle="None"
  ResizeMode="CanResize"
  AllowsTransparency="True"
  Background="Transparent"
  WindowStartupLocation="CenterOwner"
  StateChanged="Window_StateChanged"
  Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ChromeOuter" Style="{StaticResource SpSettingsChromeOuter}">
    <Border
      x:Name="ChromeRoot"
      Style="{StaticResource SpSettingsChrome}"
      SizeChanged="ChromeRoot_SizeChanged">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Style="{StaticResource SpSettingsHeader}"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="{StaticResource SpSpace.HeaderInset}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{x:Static loc:Loc.CustomFieldsPreviewTitle}"
              Style="{StaticResource SpSettingsHeaderTitle}"
              FontFamily="Arial"
              FontSize="15.5"
              FontWeight="SemiBold" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SpSettingsHeaderClose}"
              Click="Hide_Click"
              AutomationProperties.Name="{x:Static loc:Loc.Close}" />
          </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="{StaticResource SpSpace.ContentInset}">
          <TextBlock
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap"
            Text="{x:Static loc:Loc.CustomFieldsPreviewHint}" />
          <TextBlock
            x:Name="ReportNameText"
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
          <DataGrid
            x:Name="PreviewGrid"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn
                Width="1.2*"
                MinWidth="120"
                Header="{x:Static loc:Loc.CustomFieldsPreviewScope}"
                Binding="{Binding Scope}" />
              <DataGridTextColumn
                Width="*"
                MinWidth="100"
                Header="{x:Static loc:Loc.CustomFieldName}"
                Binding="{Binding FieldName}" />
              <DataGridTextColumn
                Width="1.4*"
                MinWidth="120"
                Header="{x:Static loc:Loc.CustomFieldsValue}"
                Binding="{Binding Value}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource SpSettingsFooter}">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
              MinWidth="120"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.CustomFieldsPreviewHide}"
              Click="Hide_Click"
              IsCancel="True" />
            <Button
              MinWidth="120"
              Margin="8,0,0,0"
              Style="{StaticResource SpAccentButton}"
              Content="{x:Static loc:Loc.CustomFieldsPreviewShow}"
              Click="Show_Click"
              IsDefault="True" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
