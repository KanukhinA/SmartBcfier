<UserControl
  x:Class="Bcfier.UserControls.AddView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:themes="clr-namespace:Bcfier.Themes"
  xmlns:utils="clr-namespace:Bcfier.Data.Utils"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  MinWidth="320"
  Width="Auto"
  AllowDrop="True"
  DragEnter="Window_DragEnter"
  DragLeave="Window_DragLeave"
  DragOver="Window_DragOver"
  Drop="Window_Drop">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource SpSettingsToolBar}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Canvas
          Name="whitespace"
          Grid.RowSpan="8"
          Grid.ColumnSpan="6"
          Panel.ZIndex="100"
          Background="WhiteSmoke"
          Opacity=".70"
          Visibility="Collapsed" />
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
          <TextBlock
            Style="{StaticResource SpSettingsSectionTitle}"
            Text="{x:Static loc:Loc.SnapshotsEditor}" />
          <Border Style="{StaticResource SpSettingsSectionTitleRule}" />
          <TextBlock
            Name="TextBlockInfo"
            Margin="0,2,0,0"
            Style="{StaticResource SpSettingsMutedText}"
            Text="{x:Static loc:Loc.BrowseOrDropImage}"
            TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
          <Button
            Margin="0,0,6,0"
            MinWidth="90"
            Padding="10,2"
            Style="{StaticResource SpSecondaryButton}"
            Click="Button_LoadImage"
            Content="{x:Static loc:Loc.Browse}" />
          <Button
            MinWidth="100"
            Margin="0,0,6,0"
            Padding="10,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource SpSecondaryButton}"
            Click="EditSnapshot_Click"
            Content="{x:Static loc:Loc.Annotate}" />
          <Button
            MinWidth="90"
            Padding="10,2"
            Style="{StaticResource SpSecondaryButton}"
            Click="Button_RemoveImage"
            Content="{x:Static loc:Loc.Remove}" />
        </StackPanel>
        <Border
          Grid.Row="2"
          Margin="0,6,0,0"
          Background="{StaticResource SpBrush.Card}"
          BorderBrush="{StaticResource SpBrush.BorderSubtle}"
          BorderThickness="1"
          CornerRadius="{StaticResource SpRadius.Card}"
          Padding="4">
          <Image
            x:Name="SnapshotImg"
            MaxWidth="320"
            MaxHeight="110"
            HorizontalAlignment="Left"
            Stretch="Uniform">
            <Image.Effect>
              <DropShadowEffect
                Opacity="0.5"
                BlurRadius="10"
                Direction="316"
                ShadowDepth="1" />
            </Image.Effect>
          </Image>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource SpSettingsToolBar}">
      <Expander Header="{x:Static loc:Loc.IncludeComment}" IsExpanded="False">
        <TextBox
          x:Name="CommentBox"
          MinHeight="40"
          MaxHeight="72"
          Height="48"
          Margin="0,4,0,0"
          Style="{StaticResource SpSettingsTextBox}"
          HorizontalAlignment="Stretch"
          TextWrapping="Wrap"
          AcceptsReturn="True"
          VerticalScrollBarVisibility="Auto" />
      </Expander>
    </Border>
  </Grid>
</UserControl>
