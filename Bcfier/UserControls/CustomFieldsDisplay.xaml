<UserControl
  x:Class="Bcfier.UserControls.CustomFieldsDisplay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  FontFamily="{DynamicResource SpFont.Ui}">
  <UserControl.Resources>
    <!-- Строка label+value: chrome поля при наведении на всю строку (включая лейбл) -->
    <Style x:Key="CustomFieldRow" TargetType="Border">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpRadius.Control}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource SpBrush.Card}" />
          <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CustomFieldValueBox" TargetType="TextBox" BasedOn="{StaticResource SpTextBox}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="Transparent"
              BorderThickness="0"
              SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border
    x:Name="FieldsFrame"
    Padding="10,8"
    Background="{StaticResource SpBrush.Inset}"
    BorderBrush="{StaticResource SpBrush.Border}"
    BorderThickness="1"
    CornerRadius="{StaticResource SpRadius.Card}"
    Visibility="Collapsed">
    <DockPanel LastChildFill="True">
      <TextBlock
        DockPanel.Dock="Top"
        Margin="0,0,0,8"
        FontSize="12"
        FontWeight="SemiBold"
        Foreground="{StaticResource SpBrush.Muted}"
        Text="{x:Static loc:Loc.CustomFieldsGroupTitle}" />
      <ItemsControl x:Name="ReportFieldsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CustomFieldRow}">
              <DockPanel LastChildFill="True">
              <TextBlock
                DockPanel.Dock="Left"
                MinWidth="100"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Normal"
                Foreground="{StaticResource SpBrush.Foreground}"
                Text="{Binding DisplayName}" />
                <TextBox
                  Style="{StaticResource CustomFieldValueBox}"
                  Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                  LostFocus="ReportValue_LostFocus" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </Border>
</UserControl>
