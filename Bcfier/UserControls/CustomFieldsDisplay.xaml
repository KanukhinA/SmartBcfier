<UserControl
  x:Class="Bcfier.UserControls.CustomFieldsDisplay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  FontFamily="{DynamicResource SpFont.Ui}">
  <Border
    x:Name="FieldsFrame"
    Padding="10,8"
    Background="{StaticResource SpBrush.Inset}"
    BorderBrush="{StaticResource SpBrush.Border}"
    BorderThickness="1"
    CornerRadius="{StaticResource SpRadius.Card}"
    Visibility="Collapsed">
    <DockPanel LastChildFill="True">
      <TextBlock
        DockPanel.Dock="Top"
        Margin="0,0,0,8"
        FontSize="12"
        FontWeight="SemiBold"
        Foreground="{StaticResource SpBrush.Muted}"
        Text="{x:Static loc:Loc.CustomFieldsGroupTitle}" />
      <ItemsControl x:Name="ReportFieldsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
              <TextBlock
                DockPanel.Dock="Left"
                MinWidth="100"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Normal"
                Foreground="{StaticResource SpBrush.Muted}"
                Text="{Binding DisplayName}" />
              <TextBox
                MinHeight="30"
                Height="30"
                Padding="6,3"
                FontWeight="Normal"
                VerticalContentAlignment="Center"
                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                LostFocus="ReportValue_LostFocus" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </Border>
</UserControl>
