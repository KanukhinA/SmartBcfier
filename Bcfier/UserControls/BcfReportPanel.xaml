<UserControl
  x:Class="Bcfier.UserControls.BcfReportPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:data="clr-namespace:Bcfier.Data"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:src="clr-namespace:Bcfier.Data.ValueConverters"
  xmlns:themes="clr-namespace:Bcfier.Themes"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  xmlns:local="clr-namespace:Bcfier.UserControls"
  xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
  Background="{StaticResource SpBrush.Surface}"
  MinWidth="900"
  d:DataContext="{d:DesignData d:Source=../SampleBcfFile.xaml}"
  d:DesignHeight="1500"
  d:DesignWidth="900"
  Loaded="BcfReportPanel_OnLoaded"
  FontFamily="{DynamicResource SpFont.Ui}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/IssueListStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ViewCommentListStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ScrollViewer.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ViewCommentDataTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <src:IntPluralConverter x:Key="IntPluralConverter" />
      <src:DateConverter x:Key="DateConverter" />
      <src:IntVisibConverter x:Key="IntVisibConverter" />
      <src:PathToImageConv x:Key="PathToImageConv" />
      <src:BoolVisibConverter x:Key="BoolVisibConverter" />
      <src:StatusToBrushConverter x:Key="StatusToBrushConverter" />
      <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource SpComboBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="CompactDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource SpDatePicker}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="CompactTextBoxStyle" TargetType="themes:TextPlaceholder" BasedOn="{StaticResource {x:Type themes:TextPlaceholder}}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="{StaticResource SpBrush.Surface}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="40*" />
      <ColumnDefinition Width="3" />
      <ColumnDefinition Width="60*" />
    </Grid.ColumnDefinitions>
    <!--  MAIN GRID - COLUMN 1  -->
    <Grid Background="{StaticResource SpBrush.Inset}">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <!-- Компактная строка: поиск (+ пакетное добавление, если доступно) -->
      <Border Grid.Row="1" Style="{StaticResource SpSettingsToolBar}">
        <DockPanel LastChildFill="True">
          <themes:ButtonIcon
            x:Name="AddIssuesBtn"
            DockPanel.Dock="Left"
            Style="{StaticResource IssueListAddButton}"
            Command="data:Commands.AddIssues"
            IconPath="{StaticResource IconAdd}"
            ToolTip="{x:Static loc:Loc.BatchAdd}"
            Opacity="0.85"
            Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource BoolVisibConverter}}" />
          <themes:TextPlaceholder
            x:Name="SearchBox"
            MinHeight="30"
            Height="30"
            Padding="0,3"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Style="{StaticResource SpBoxedTextPlaceholder}"
            PlaceholderColor="{StaticResource SpBrush.Muted}"
            KeyDown="SearchBox_OnKeyDown"
            Placeholder="{x:Static loc:Loc.SearchIssues}"
            Text="{Binding TextSearch, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="{x:Static loc:Loc.SearchIssuesTip}" />
        </DockPanel>
      </Border>
      <!-- Список + «+ замечание»: под последней карточкой или закреплена снизу при скролле -->
      <Border
        x:Name="IssueListHost"
        Grid.Row="2"
        Background="Transparent"
        SizeChanged="IssueListHost_SizeChanged">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition x:Name="IssueListContentRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="IssueListFillerRow" Height="0" />
          </Grid.RowDefinitions>
          <ListView
            x:Name="IssueList"
            Grid.Row="0"
            Margin="0"
            Padding="0"
            Style="{StaticResource ListViewTheme}"
            Background="Transparent"
            BorderThickness="0"
            AlternationCount="2"
            VerticalAlignment="Top"
            IsSynchronizedWithCurrentItem="True"
            ItemContainerStyle="{StaticResource IssueListStyle}"
            ItemsSource="{Binding View}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedIndex="0"
            SelectedItem="{Binding SelectedIssue}"
            SelectionMode="Extended"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            >
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <!-- Превью снимка в списке замечаний -->
              <Grid
                Grid.RowSpan="2"
                Width="120"
                Height="72"
                Margin="0,0,8,0"
                HorizontalAlignment="Left"
                ClipToBounds="True">
                <Image
                  Style="{StaticResource ImageNullSource}"
                  Source="{Binding Viewpoints[0].SnapshotPath, Converter={StaticResource PathToImageConv}, UpdateSourceTrigger=PropertyChanged}"
                  Stretch="UniformToFill"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label
                  Grid.Column="0"
                  Margin="2,2,4,0"
                  VerticalAlignment="Center"
                  FontWeight="Bold"
                  Content="{Binding Topic.Title, TargetNullValue={x:Static loc:Loc.NewIssue}}" />
                <themes:ButtonIcon
                  Grid.Column="1"
                  Margin="0,0,0,0"
                  Style="{StaticResource IssueRowCloseButton}"
                  Command="data:Commands.DeleteIssues"
                  CommandParameter="{Binding}"
                  ToolTip="{x:Static loc:Loc.DeleteSelected}" />
              </Grid>
              <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="0,0,0,4"
                HorizontalAlignment="Stretch"
                BorderBrush="{StaticResource SpBrush.BorderSubtle}"
                BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                  <!-- Сначала справа: статус не сжимается ниже «В работе»; скрыт, если статус не задан -->
                  <Border
                    MinWidth="72"
                    MaxWidth="120"
                    Margin="6,0,2,4"
                    Padding="7,2"
                    VerticalAlignment="Bottom"
                    Background="{Binding Topic.TopicStatus, Converter={StaticResource StatusToBrushConverter}}"
                    CornerRadius="4"
                    DockPanel.Dock="Right"
                    ToolTip="{Binding Topic.TopicStatus}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Topic.TopicStatus}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Topic.TopicStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{Binding Topic.TopicStatus, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=fg}"
                      Text="{Binding Topic.TopicStatus}"
                      TextAlignment="Center"
                      TextTrimming="CharacterEllipsis" />
                  </Border>
                  <Label
                    VerticalAlignment="Bottom"
                    Foreground="{StaticResource SpTextSecondaryBrush}"
                    Content="{Binding Topic.CreationDate, Converter={StaticResource DateConverter}, ConverterParameter='relative'}"
                    ToolTip="{Binding Topic.CreationDate, Converter={StaticResource DateConverter}}" />
                  <Path
                    Width="14"
                    Height="14"
                    Margin="4,0,0,6"
                    VerticalAlignment="Bottom"
                    Fill="{StaticResource SpBrush.Primary}"
                    Data="{StaticResource IconViewPoint}"
                    Stretch="Uniform"
                    ToolTip="{Binding Viewpoints.Count, Converter={StaticResource IntPluralConverter}, ConverterParameter=Viewpoints}"
                    UseLayoutRounding="False" />
                  <Label
                    VerticalAlignment="Bottom"
                    Content="{Binding Viewpoints.Count}"
                    ToolTip="{Binding Viewpoints.Count, Converter={StaticResource IntPluralConverter}, ConverterParameter=Viewpoints}" />
                  <Path
                    Width="14"
                    Height="14"
                    Margin="4,0,0,6"
                    VerticalAlignment="Bottom"
                    Fill="{StaticResource SpBrush.Primary}"
                    Data="{StaticResource IconComment}"
                    Stretch="Uniform"
                    ToolTip="{Binding Comment.Count, Converter={StaticResource IntPluralConverter}, ConverterParameter=Comments}"
                    UseLayoutRounding="False" />
                  <Label
                    Margin="0,0,6,0"
                    VerticalAlignment="Bottom"
                    Content="{Binding Comment.Count}"
                    ToolTip="{Binding Comment.Count, Converter={StaticResource IntPluralConverter}, ConverterParameter=Comments}" />
                </DockPanel>
              </Border>
            </Grid>
            <DataTemplate.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}" />
              </EventTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
          <Button
            x:Name="AddIssueBtn"
            Grid.Row="1"
            Style="{StaticResource TableAddIssueLink}"
            Content="{x:Static loc:Loc.TableAddIssueLink}"
            ToolTip="{x:Static loc:Loc.AddIssue}"
            Command="data:Commands.AddIssue" />
        </Grid>
      </Border>
      <!-- Фильтры списка (без кнопок добавить/удалить — они у поиска и на карточках) -->
      <Border Grid.Row="0" Style="{StaticResource SpSettingsToolBar}">
      <StackPanel
        VerticalAlignment="Center"
        Orientation="Vertical">
          <CheckBox
            VerticalAlignment="Center"
            Content="{x:Static loc:Loc.ActiveDocumentIssuesOnly}"
            IsChecked="{Binding ShowOnlyActiveDocumentIssues, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding Source={x:Static data:BcfHostCapabilities.SupportsActiveDocumentFilter}, Converter={StaticResource BoolVisibConverter}}" />
          <DockPanel Margin="{StaticResource SpSpace.RowGap}" LastChildFill="True">
            <TextBlock
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{StaticResource SpBrush.Foreground}"
              Text="{x:Static loc:Loc.BcfCoordinateMode}" />
            <ComboBox
              x:Name="BcfCoordinateModeCombo"
              MinWidth="180"
              MaxWidth="260"
              Style="{StaticResource CompactComboBoxStyle}"
              Tag="{x:Static loc:Loc.BcfCoordinateMode}"
              SelectionChanged="BcfCoordinateModeCombo_SelectionChanged">
              <ComboBoxItem Tag="RevitZUp" Content="{x:Static loc:Loc.BcfCoordinateModeRevitZUp}" />
              <ComboBoxItem Tag="SourceYUp" Content="{x:Static loc:Loc.BcfCoordinateModeSourceYUp}" />
              <ComboBoxItem Tag="SourceXUp" Content="{x:Static loc:Loc.BcfCoordinateModeSourceXUp}" />
            </ComboBox>
          </DockPanel>
      </StackPanel>
      </Border>
      <Border
        Grid.Row="3"
        Grid.Column="0"
        Style="{StaticResource SpSettingsToolBar}"
        Margin="0">
        <DockPanel LastChildFill="False">
          <TextBlock
            DockPanel.Dock="Top"
            Margin="{StaticResource SpSpace.FieldGap}"
            FontSize="11.5"
            Foreground="{StaticResource SpBrush.Muted}"
            TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding OriginatingSystemsDisplay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
            <Run Text="{x:Static loc:Loc.OriginatingSystemLabel}" />
            <Run Text=": " />
            <Run Text="{Binding OriginatingSystemsDisplay, Mode=OneWay}" />
          </TextBlock>
          <Label
            VerticalAlignment="Bottom"
            Content="{Binding ElementName=IssueList, Path=Items.Count, Converter={StaticResource IntPluralConverter}, ConverterParameter=Issues}"
            DockPanel.Dock="Left" />
          <Label
            VerticalAlignment="Bottom"
            Content="{Binding ElementName=IssueList, Path=SelectedItems.Count, Converter={StaticResource IntPluralConverter}, ConverterParameter=Selected}"
            DockPanel.Dock="Left" />
        </DockPanel>
      </Border>
    </Grid>
    <!--  MAIN GRID - COLUMN 2  -->
    <GridSplitter
      Grid.RowSpan="3"
      Grid.Column="1"
      Margin="0"
      Padding="0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Background="{StaticResource SpBrush.BorderSubtle}"
      BorderThickness="0" />
    <!--  MAIN GRID - COLUMN 3  -->
    <!--    -->
    <Grid
      Grid.Column="2"
      DataContext="{Binding ElementName=IssueList, Path=SelectedItem}"
      Visibility="{Binding ElementName=IssueList, Path=SelectedItems.Count, Converter={StaticResource IntVisibConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!--  ISSUE INFO: сгруппировано в Card; единый вертикальный ритм SpSpace.FieldGap -->
      <Border
        Grid.Row="0"
        Margin="{StaticResource SpSpace.ContentInsetTop}"
        Padding="{StaticResource SpSpace.ContentInset}"
        Background="{StaticResource SpBrush.Card}"
        BorderBrush="{StaticResource SpBrush.Border}"
        BorderThickness="1"
        CornerRadius="{StaticResource SpRadius.Card}"
        SnapsToDevicePixels="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <themes:TextPlaceholder
          x:Name="TextBox_Title"
          Grid.Row="0"
          Margin="{StaticResource SpSpace.FieldGap}"
          Style="{StaticResource CompactTextBoxStyle}"
          VerticalAlignment="Center"
          FontSize="14"
          FontWeight="Bold"
          Binding.SourceUpdated="TextBox_OnTextChanged"
          Placeholder="{x:Static loc:Loc.IssueTitle}"
          Text="{Binding Topic.Title, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Автор создания — только текст -->
        <DockPanel
          Grid.Row="2"
          Margin="{StaticResource SpSpace.FieldGap}"
          LastChildFill="True">
          <TextBlock
            DockPanel.Dock="Left"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Style="{StaticResource SpSettingsBodyText}"
            Text="{x:Static loc:Loc.CreationAuthor}" />
          <TextBlock
            VerticalAlignment="Center"
            Foreground="{StaticResource SpBrush.Foreground}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{x:Static loc:Loc.CreationAuthor}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} · {1}">
                <Binding Path="Topic.CreationAuthor" />
                <Binding Path="Topic.CreationDate" Converter="{StaticResource DateConverter}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </DockPanel>

        <!-- Ответственный — одна строка, без других контролов -->
        <DockPanel
          Grid.Row="3"
          Margin="{StaticResource SpSpace.FieldGap}"
          LastChildFill="True">
          <TextBlock
            DockPanel.Dock="Left"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Style="{StaticResource SpSettingsBodyText}"
            Text="{x:Static loc:Loc.AssignedTo}" />
          <ComboBox
            VerticalAlignment="Center"
            IsEditable="True"
            StaysOpenOnEdit="True"
            IsTextSearchEnabled="False"
            Style="{StaticResource CompactComboBoxStyle}"
            ItemsSource="{Binding Topic.AssigneesCollection}"
            Text="{Binding Topic.AssignedTo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </DockPanel>

        <!-- Статус, тип, приоритет, дата — ниже ответственного -->
        <Grid
          Grid.Row="4"
          Margin="{StaticResource SpSpace.FieldGap}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100" />
            <ColumnDefinition Width="1.2*" MinWidth="120" />
            <ColumnDefinition Width="*" MinWidth="90" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox
            Grid.Column="0"
            Margin="0,0,6,0"
            Style="{StaticResource CompactComboBoxStyle}"
            Tag="{x:Static loc:Loc.Status}"
            ItemsSource="{Binding Topic.TopicStatusesCollection}"
            SelectedItem="{Binding Topic.TopicStatus}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border
                    Width="10"
                    Height="10"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Background="{Binding Converter={StaticResource StatusToBrushConverter}}"
                    CornerRadius="2" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox
            Grid.Column="1"
            Margin="0,0,6,0"
            Style="{StaticResource CompactComboBoxStyle}"
            Tag="{x:Static loc:Loc.TopicType}"
            ItemsSource="{Binding Topic.TopicTypesCollection}"
            SelectedItem="{Binding Topic.TopicType, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border
                    Width="10"
                    Height="10"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Background="{Binding Converter={StaticResource StatusToBrushConverter}, ConverterParameter=type}"
                    CornerRadius="2" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox
            Grid.Column="2"
            Margin="0,0,6,0"
            Style="{StaticResource CompactComboBoxStyle}"
            Tag="{x:Static loc:Loc.Priority}"
            ItemsSource="{Binding Topic.PrioritiesCollection}"
            SelectedItem="{Binding Topic.Priority, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border
                    Width="10"
                    Height="10"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Background="{Binding Converter={StaticResource StatusToBrushConverter}, ConverterParameter=priority}"
                    CornerRadius="2" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <DatePicker
            x:Name="DueDatePicker"
            Grid.Column="3"
            Width="110"
            VerticalAlignment="Center"
            Tag="xx.xx.xxxx"
            Style="{StaticResource CompactDatePickerStyle}"
            SelectedDateFormat="Short"
            SelectedDateChanged="DueDatePicker_SelectedDateChanged" />
        </Grid>

        <StackPanel
          Grid.Row="1"
          Margin="{StaticResource SpSpace.FieldGap}">
          <DockPanel LastChildFill="False">
            <Button
              MinHeight="30"
              Padding="8,3"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.CustomFieldsAddToTopic}"
              Click="AddCustomFields_Click" />
          </DockPanel>
          <local:CustomFieldsDisplay
            x:Name="CustomFieldsBlock"
            Margin="{StaticResource SpSpace.RowGap}"
            BcfFile="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
            FieldsChanged="CustomFieldsBlock_FieldsChanged" />
        </StackPanel>

        <ComboBox
          x:Name="LabelsCombo"
          Grid.Row="5"
          Margin="{StaticResource SpSpace.FieldGap}"
          Style="{StaticResource CompactComboBoxStyle}"
          Tag="{x:Static loc:Loc.Labels}"
          ItemsSource="{Binding Topic.LabelsCollection}"
          SelectionChanged="LabelsCombo_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Border
                  Width="10"
                  Height="10"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Background="{Binding Converter={StaticResource StatusToBrushConverter}, ConverterParameter=label}"
                  CornerRadius="2" />
                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <themes:TextPlaceholder
          Grid.Row="6"
          Style="{StaticResource CompactTextBoxStyle}"
          MinHeight="30"
          MaxHeight="56"
          Margin="{StaticResource SpSpace.FieldGap}"
          AcceptsReturn="True"
          Binding.SourceUpdated="TextBox_OnTextChanged"
          Placeholder="{x:Static loc:Loc.Description}"
          Text="{Binding Topic.Description, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto" />
        <themes:ButtonIcon
          Grid.Row="7"
          MinHeight="30"
          MinWidth="140"
          Margin="0"
          Padding="8,3"
          HorizontalAlignment="Left"
          Style="{StaticResource AddViewCommentStyle}"
          Command="data:Commands.AddView"
          CommandParameter="{Binding ElementName=IssueList, Path=SelectedItem}"
          Content="{x:Static loc:Loc.AddView}"
          IconColor="{StaticResource SpBrush.Primary}"
          IconPath="{StaticResource IconAdd}" />
      </Grid>
      </Border>
      <!-- <StackPanel Orientation="Horizontal" Grid.Row="1"  >

        <Button Margin="5" Cursor="Hand" ToolTip="Click to open Snapshot"
                Visibility="{Binding  ElementName=IssueList, Path=SelectedItems.Count, Converter={StaticResource IntVisibConverter}}"
                HorizontalAlignment="Stretch"   Grid.Row="0" VerticalAlignment="Stretch" Height="60"  Name="OpenImageBtn"
                Tag="{Binding snapshot}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Grid>
              <Image Height="60" Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Source="{Binding snapshot, Converter={StaticResource PathToImageConv}}" />
            </Grid>
          </Button>-->
      <!--<StackPanel Orientation="Vertical">
          </StackPanel>
      </StackPanel>-->
      <!--  VIEWPOINT  -->
      <ListView
        Name="ViewCommList"
        Grid.Row="1"
        Margin="{StaticResource SpSpace.ContentInset}"
        HorizontalContentAlignment="Stretch"
        Style="{StaticResource ListViewTheme}"
        Background="Transparent"
        BorderThickness="0"
        ItemContainerStyle="{StaticResource ViewCommentListStyle}"
        ItemTemplate="{StaticResource ViewCommentDataTemplate}"
        ItemsSource="{Binding ElementName=IssueList, Path=SelectedItem.ViewComments}"
        ScrollViewer.CanContentScroll="False"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Visible" />
      <!--  VIEWPOINTS CONTROLS  -->
      <!--<DockPanel  >
        <util:ButtonIcon Command="data:Commands.AddView" CommandParameter="{Binding ElementName=IssueList, Path=SelectedItem}" ToolTip="Add View" DockPanel.Dock="Left" Name="AddViewBtn" Margin="2" Style="{StaticResource IssuesSelectedEnablerStyle}"
                    Content="Add View" IconColor="Green" IconPath="{StaticResource IconAdd}"/>
        <util:ButtonIcon Command="data:Commands.DeleteViews" ToolTip="Delete selected view" DockPanel.Dock="Left" Margin="2"  Name="DelViewBtn" HorizontalAlignment="Left"
                    Style="{StaticResource ViewSelectedEnablerStyle}"
                    Content="Delete View" IconColor="Red" IconPath="{StaticResource IconDelete}">
          <Button.CommandParameter>
            <MultiBinding Converter="{StaticResource MultiCommandConverter}">
              <Binding ElementName="ViewpointList" Path="SelectedItems" />
              <Binding ElementName="IssueList" Path="SelectedItem" />
            </MultiBinding>
          </Button.CommandParameter>
        </util:ButtonIcon>
        <util:ButtonIcon Command="data:Commands.OpenView" ToolTip="Open View in the 3D space"  Name="Open3DViewBtn" Margin="2" HorizontalAlignment="Stretch"
                  Content="Open View" IconColor="#00A2E1" IconPath="{StaticResource IconView}"  Style="{StaticResource ViewSelectedEnablerStyle}">
          <Button.CommandParameter>
            <MultiBinding Converter="{StaticResource MultiCommandConverter}">
              <Binding ElementName="ViewpointList" Path="SelectedItem" />
              <Binding ElementName="IssueList" Path="SelectedItem" />
            </MultiBinding>
          </Button.CommandParameter>
        </util:ButtonIcon>
        <util:ButtonIcon Command="data:Commands.OpenComponents" CommandParameter="{Binding ElementName=ViewpointList, Path=SelectedItem}"
                         ToolTip="Show list of elements attached to the view"  Name="ComponentsShowBtn" Margin="2" Content="Elements List"
                            HorizontalAlignment="Left"  IconColor="#00A2E1" IconPath="{StaticResource IconList}"
