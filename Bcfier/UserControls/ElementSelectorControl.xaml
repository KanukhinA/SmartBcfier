<UserControl
  x:Class="Bcfier.UserControls.ElementSelectorControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  MinHeight="0">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="TransferArrowButton" TargetType="Button" BasedOn="{StaticResource SpSecondaryButton}">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0">
    <!-- Режим чекбоксов (ComponentsList) -->
    <Grid x:Name="ListModePanel">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="80" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource SpSettingsToolBar}">
        <DockPanel LastChildFill="True">
          <StackPanel x:Name="SectionHeaderPanel" DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock
              Style="{StaticResource SpSettingsSectionTitle}"
              Text="{x:Static loc:Loc.ViewElements}" />
            <Border Style="{StaticResource SpSettingsSectionTitleRule}" />
          </StackPanel>
          <TextBox
            x:Name="FilterBox"
            Margin="0,0,0,8"
            Style="{StaticResource SpFilterSearchTextBoxStyle}"
            TextChanged="FilterBox_OnTextChanged" />
          <StackPanel Orientation="Horizontal">
            <Button
              Margin="0,0,6,0"
              Padding="10,2"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.SelectAll}"
              Click="SelectAll_Click" />
            <Button
              Padding="10,2"
              Style="{StaticResource SpSecondaryButton}"
              Content="{x:Static loc:Loc.DeselectAll}"
              Click="DeselectAll_Click" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SpSettingsToolBar}">
        <ListView
          x:Name="ItemsList"
          Background="{StaticResource SpBrush.Field}"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <Border
                    Margin="0,4,0,2"
                    Padding="6,3"
                    Background="#22005E96"
                    BorderBrush="{StaticResource SpBrush.BorderSubtle}"
                    BorderThickness="0,0,0,1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  </Border>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Width="40">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="IdColumn" Header="{x:Static loc:Loc.ColumnId}" Width="120" DisplayMemberBinding="{Binding AuthoringToolId}" />
              <GridViewColumn x:Name="IfcGuidColumn" Header="{x:Static loc:Loc.ColumnIfcGuid}" Width="220" DisplayMemberBinding="{Binding IfcGuid}" />
              <GridViewColumn x:Name="FamilyColumn" Header="{x:Static loc:Loc.ColumnFamily}" Width="0" DisplayMemberBinding="{Binding FamilyName}" />
              <GridViewColumn x:Name="TypeColumn" Header="{x:Static loc:Loc.ColumnType}" Width="0" DisplayMemberBinding="{Binding TypeName}" />
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>

    <!-- Dual-list: доступные | стрелки | выбранные (Добавить вид) -->
    <Grid x:Name="DualListPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="220" />
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SpSettingsToolBar}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock
              Style="{StaticResource SpSettingsSectionTitle}"
              Text="{x:Static loc:Loc.AvailableOnView}" />
            <Border Style="{StaticResource SpSettingsSectionTitleRule}" />
          </StackPanel>
          <TextBox
            x:Name="DualFilterBox"
            Grid.Row="1"
            Margin="0,0,0,6"
            Style="{StaticResource SpFilterSearchTextBoxStyle}"
            TextChanged="DualFilterBox_OnTextChanged" />
          <ListView
            x:Name="AvailableList"
            Grid.Row="2"
            Background="{StaticResource SpBrush.Field}"
            SelectionMode="Extended"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            MouseDoubleClick="AvailableList_MouseDoubleClick"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="AvailableIdColumn" Header="{x:Static loc:Loc.ColumnId}" Width="70" DisplayMemberBinding="{Binding AuthoringToolId}" />
                <GridViewColumn x:Name="AvailableFamilyColumn" Header="{x:Static loc:Loc.ColumnFamily}" Width="110" DisplayMemberBinding="{Binding FamilyName}" />
                <GridViewColumn x:Name="AvailableTypeColumn" Header="{x:Static loc:Loc.ColumnType}" Width="120" DisplayMemberBinding="{Binding TypeName}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>

      <StackPanel
        Grid.Column="1"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">
        <Button
          Style="{StaticResource TransferArrowButton}"
          Content="→"
          ToolTip="{x:Static loc:Loc.MoveToSelected}"
          Click="MoveToSelected_Click" />
        <Button
          Style="{StaticResource TransferArrowButton}"
          Content="⇒"
          ToolTip="{x:Static loc:Loc.MoveAllToSelected}"
          Click="MoveAllToSelected_Click" />
        <Button
          Style="{StaticResource TransferArrowButton}"
          Content="←"
          ToolTip="{x:Static loc:Loc.MoveToAvailable}"
          Click="MoveToAvailable_Click" />
        <Button
          Style="{StaticResource TransferArrowButton}"
          Content="⇐"
          ToolTip="{x:Static loc:Loc.MoveAllToAvailable}"
          Click="MoveAllToAvailable_Click" />
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource SpSettingsToolBar}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,6">
            <TextBlock
              Style="{StaticResource SpSettingsSectionTitle}"
              Text="{x:Static loc:Loc.SelectedElements}" />
            <Border Style="{StaticResource SpSettingsSectionTitleRule}" />
          </StackPanel>
          <ListView
            x:Name="SelectedList"
            Grid.Row="1"
            Background="{StaticResource SpBrush.Field}"
            SelectionMode="Extended"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            MouseDoubleClick="SelectedList_MouseDoubleClick"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="SelectedIdColumn" Header="{x:Static loc:Loc.ColumnId}" Width="70" DisplayMemberBinding="{Binding AuthoringToolId}" />
                <GridViewColumn x:Name="SelectedFamilyColumn" Header="{x:Static loc:Loc.ColumnFamily}" Width="110" DisplayMemberBinding="{Binding FamilyName}" />
                <GridViewColumn x:Name="SelectedTypeColumn" Header="{x:Static loc:Loc.ColumnType}" Width="120" DisplayMemberBinding="{Binding TypeName}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- Режим переполнения: ошибка + ручной ввод Id -->
    <Border
      x:Name="ManualModePanel"
      Visibility="Collapsed"
      Style="{StaticResource SpSettingsToolBar}">
      <StackPanel>
        <TextBlock
          x:Name="ManualErrorText"
          Margin="0,0,0,8"
          Foreground="#FFDC2626"
          Style="{StaticResource SpSettingsBodyText}"
          Text="{x:Static loc:Loc.TooManyViewElements}"
          TextWrapping="Wrap" />
        <TextBlock
          Margin="0,0,0,6"
          Opacity="0.75"
          Style="{StaticResource SpSettingsMutedText}"
          Text="{x:Static loc:Loc.ManualElementIdsHint}"
          TextWrapping="Wrap" />
        <TextBox
          x:Name="ManualIdsBox"
          MinHeight="60"
          AcceptsReturn="True"
          Style="{StaticResource SpSettingsTextBox}"
          TextChanged="ManualIdsBox_OnTextChanged"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
