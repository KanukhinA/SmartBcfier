<UserControl
  x:Class="Bcfier.UserControls.TableCommentCell"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Bcfier.Localization"
  xmlns:src="clr-namespace:Bcfier.Data.ValueConverters"
  FontFamily="{DynamicResource SpFont.Ui}">
  <UserControl.Resources>
    <src:BoolVisibConverter x:Key="BoolVisibConverter" />
    <Style x:Key="TableCommentEditBox" TargetType="TextBox" BasedOn="{StaticResource SpTextBox}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="MaxHeight" Value="100" />
    </Style>
  </UserControl.Resources>

  <StackPanel Margin="6,4">
    <ItemsControl x:Name="CommentsList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border
            Margin="0,0,0,6"
            Padding="0"
            BorderBrush="{StaticResource SpBrush.BorderSubtle}"
            BorderThickness="0,0,0,1">
            <StackPanel Margin="0,0,0,6">
              <TextBlock
                Margin="0,0,0,2"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource SpBrush.Muted}"
                Text="{Binding Author}" />
              <TextBox
                Style="{StaticResource TableCommentEditBox}"
                Text="{Binding Comment1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding CanModify, Converter={StaticResource BoolVisibConverter}}"
                LostFocus="OwnComment_LostFocus" />
              <TextBlock
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{StaticResource SpBrush.Foreground}"
                Text="{Binding Comment1}"
                Visibility="{Binding CanModify, Converter={StaticResource BoolVisibConverter}, ConverterParameter=opposite}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel x:Name="AddPanel" Visibility="Collapsed">
      <TextBox
        x:Name="AddBox"
        Style="{StaticResource TableCommentEditBox}"
        Tag="{x:Static loc:Loc.TableCommentAddPlaceholder}"
        KeyDown="AddBox_KeyDown" />
      <Button
        Margin="0,4,0,0"
        MinHeight="26"
        Padding="8,3"
        HorizontalAlignment="Left"
        Style="{StaticResource SpSecondaryButton}"
        Content="{x:Static loc:Loc.AddComment}"
        Click="AddComment_Click" />
    </StackPanel>
  </StackPanel>
</UserControl>
