<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:themes="clr-namespace:Bcfier.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Плотная панель табличного режима -->
  <Style x:Key="SpReportTableToolBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SpBrush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpRadius.Card}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Flat-кнопки тулбара без neo-тени -->
  <Style x:Key="SpReportTableToolButton" TargetType="themes:ButtonIcon" BasedOn="{StaticResource RoundedButtonIconStyle}">
    <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="IconColor" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="IconSize" Value="14" />
    <Setter Property="IconMargin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="themes:ButtonIcon">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{StaticResource SpBrush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource SpRadius.Control}"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
              <Path
                x:Name="Icon"
                Width="{Binding IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                Height="{Binding IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                Margin="{Binding IconMargin, RelativeSource={RelativeSource TemplatedParent}}"
                VerticalAlignment="Center"
                Data="{TemplateBinding IconPath}"
                Fill="{TemplateBinding IconColor}"
                Stretch="Uniform"
                SnapsToDevicePixels="True" />
              <ContentPresenter
                VerticalAlignment="Center"
                RecognizesAccessKey="True"
                TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Inset}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Primary}" />
              <Setter Property="IconColor" Value="{StaticResource SpBrush.Primary}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Inset}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.AccentDeep}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpReportTableCellText" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style x:Key="SpReportTableHeaderText" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SpReportDataGridColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource SpBrush.Inset}" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="36" />
  </Style>

  <Style x:Key="SpReportDataGridCell" TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Top" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#1A2F6FED" />
        <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SpReportDataGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="MinHeight" Value="36" />
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{StaticResource SpBrush.Card}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#142F6FED" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#1A2F6FED" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Современный DataGrid отчёта (без переопределения всего ControlTemplate) -->
  <Style x:Key="SpReportDataGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RowBackground" Value="{StaticResource SpBrush.Field}" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource SpBrush.Card}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SpBrush.BorderSubtle}" />
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SpBrush.BorderSubtle}" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserResizeRows" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinRowHeight" Value="36" />
    <Setter Property="ColumnHeaderHeight" Value="36" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource SpReportDataGridColumnHeader}" />
    <Setter Property="CellStyle" Value="{StaticResource SpReportDataGridCell}" />
    <Setter Property="RowStyle" Value="{StaticResource SpReportDataGridRow}" />
  </Style>
</ResourceDictionary>
