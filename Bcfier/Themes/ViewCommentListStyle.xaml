<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:themes="clr-namespace:Bcfier.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="ViewCommentListStyle" TargetType="{x:Type ListViewItem}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid HorizontalAlignment="Stretch" SnapsToDevicePixels="true">
            <Border
              Background="{StaticResource SpBrush.Card}"
              CornerRadius="{StaticResource SpRadius.Card}"
              Effect="{StaticResource SpEffect.NeoRaised}" />
            <Border
              Name="Border"
              Padding="0"
              Background="{StaticResource SpBrush.Card}"
              BorderBrush="{StaticResource SpBrush.BorderSubtle}"
              BorderThickness="1"
              CornerRadius="{StaticResource SpRadius.Card}"
              themes:SpWindowChrome.ClipRadius="8">
              <ContentPresenter />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
