<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:themes="clr-namespace:Bcfier.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style
    x:Key="MainMenuButton"
    BasedOn="{StaticResource {x:Type themes:ButtonIcon}}"
    TargetType="themes:ButtonIcon">
    <Style.Setters>
      <Setter Property="IconColor" Value="{StaticResource SpBrush.Foreground}" />
      <Setter Property="HighlightColor" Value="{StaticResource SpBrush.Accent}" />
      <Setter Property="IsVertical" Value="True" />
      <Setter Property="IconSizeVertical" Value="16" />
      <Setter Property="IconMarginVertical" Value="2,0,2,1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="DisabledIconColor" Value="#995A6570" />
      <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
      <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style.Setters>
  </Style>

  <Style
    x:Key="CanSaveEnablerStyle"
    BasedOn="{StaticResource MainMenuButton}"
    TargetType="themes:ButtonIcon">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=BcfTabControl, Path=SelectedIndex}" Value="-1">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="IssuesSelectedEnablerStyle" BasedOn="{StaticResource RoundedButtonIconStyle}" TargetType="themes:ButtonIcon">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=IssueList, Path=SelectedItems.Count}" Value="0">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ImageNullSource" TargetType="Image">
    <Style.Triggers>
      <Trigger Property="Source" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style
    x:Key="AddViewCommentStyle"
    BasedOn="{StaticResource RoundedButtonIconStyle}"
    TargetType="themes:ButtonIcon">
    <Style.Setters>
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style.Setters>
  </Style>

  <Style
    x:Key="AddCommentEnablerStyle"
    BasedOn="{StaticResource RoundedButtonIconStyle}"
    TargetType="themes:ButtonIcon">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="Padding" Value="6,4" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=IssueList, Path=SelectedItems.Count}" Value="0">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ElementName=TextBoxComment, Path=Text}" Value="{x:Static system:String.Empty}">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Round send button (Telegram-like compose) -->
  <Style
    x:Key="ChatSendButtonStyle"
    BasedOn="{StaticResource AddCommentEnablerStyle}"
    TargetType="themes:ButtonIcon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="IconMargin" Value="1,0,0,0" />
    <Setter Property="IconColor" Value="{StaticResource SpBrush.OnPrimary}" />
    <Setter Property="Background" Value="{StaticResource SpBrush.Primary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="themes:ButtonIcon">
          <Border
            x:Name="Bd"
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            Background="{TemplateBinding Background}"
            CornerRadius="14"
            SnapsToDevicePixels="True">
            <Viewbox
              Width="13"
              Height="13"
              Margin="{TemplateBinding IconMargin}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
              <Path
                Data="{TemplateBinding IconPath}"
                Fill="{TemplateBinding IconColor}"
                Stretch="Uniform" />
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.AccentDeep}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AddIssueWin" BasedOn="{StaticResource SpAccentButton}" TargetType="Button">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=TitleBox, Path=Text}" Value="{x:Static system:String.Empty}">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="AnnotateSnapshot" BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=SnapshotImg, Path=Source}" Value="{x:Null}">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FieldSelectedEnablerStyle" BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=FieldList, Path=SelectedItems.Count}" Value="0">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ViewSelectedEnablerStyle" BasedOn="{StaticResource RoundedButtonIconStyle}" TargetType="themes:ButtonIcon">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=ViewpointList, Path=SelectedItems.Count}" Value="0">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ProjectSelectedEnablerStyle" BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=ProjectCombo, Path=SelectedIndex}" Value="-1">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ProjectSelectedGridEnablerStyle" TargetType="Grid">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=ProjectCombo, Path=SelectedIndex}" Value="-1">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CommentsSelectedEnablerStyle" BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=CommentList, Path=SelectedItems.Count}" Value="0">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="IssueCountEnablerStyle" BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ElementName=IssueList, Path=Items.Count}" Value="0">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Standardbutton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            Name="border"
            Padding="2"
            Background="Transparent"
            BorderThickness="0">
            <ContentPresenter
              Name="content"
              HorizontalAlignment="Left"
              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Панель вида: всегда видимые SP Secondary-кнопки над снимком -->
  <Style x:Key="OverlayButton" BasedOn="{StaticResource RoundedButtonIconStyle}" TargetType="themes:ButtonIcon">
    <Style.Setters>
      <Setter Property="IsVertical" Value="False" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{StaticResource SpBrush.ButtonRaised}" />
      <Setter Property="IconSize" Value="14" />
      <Setter Property="IconMargin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IconColor" Value="{StaticResource SpBrush.Foreground}" />
      <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Visibility" Value="Visible" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style.Setters>
  </Style>

  <!-- Квадратная иконка без подписи (увеличить / удалить) -->
  <Style
    x:Key="OverlayIconButton"
    BasedOn="{StaticResource OverlayButton}"
    TargetType="themes:ButtonIcon">
    <Style.Setters>
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="IconMargin" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style.Setters>
  </Style>

  <!-- Компактный «+» для списка замечаний (batch add и legacy) -->
  <Style
    x:Key="IssueListAddButton"
    BasedOn="{StaticResource RoundedButtonIconStyle}"
    TargetType="themes:ButtonIcon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="IconSize" Value="14" />
    <Setter Property="IconMargin" Value="0" />
    <Setter Property="IconColor" Value="{StaticResource SpBrush.OnPrimary}" />
    <Setter Property="Background" Value="{StaticResource SpBrush.ButtonSolid}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ToolTipService.Placement" Value="Bottom" />
  </Style>

  <!-- Текстовая ссылка «+ …» для инлайн-добавления (таблица / список карточек) -->
  <Style x:Key="TableAddSnapshotLink" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Primary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <TextBlock
              x:Name="AddLinkText"
              Text="{TemplateBinding Content}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="AddLinkText" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TableAddIssueLink" TargetType="Button" BasedOn="{StaticResource TableAddSnapshotLink}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- Призрачный крестик на карточке замечания (компактный) -->
  <Style
    x:Key="IssueRowCloseButton"
    BasedOn="{StaticResource RoundedButtonIconStyle}"
    TargetType="themes:ButtonIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="MinWidth" Value="11" />
    <Setter Property="MinHeight" Value="11" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="IconSize" Value="5" />
    <Setter Property="IconMargin" Value="0" />
    <Setter Property="IconPath" Value="{StaticResource IconXClose}" />
    <Setter Property="IconColor" Value="{StaticResource SpBrush.Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="ToolTipService.Placement" Value="Bottom" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="themes:ButtonIcon">
          <Border
            x:Name="Bd"
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            Background="{TemplateBinding Background}"
            CornerRadius="2"
            SnapsToDevicePixels="True">
            <Path
              x:Name="Icon"
              Width="{TemplateBinding IconSize}"
              Height="{TemplateBinding IconSize}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="{TemplateBinding IconPath}"
              Fill="{TemplateBinding IconColor}"
              Stretch="Uniform" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1ADC2626" />
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource SpBrush.Destructive}" />
              <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#33DC2626" />
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource SpBrush.Destructive}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Крестик закрытия вкладки отчёта: то же "призрачное" оформление, что и у крестика
    на карточке замечания — прозрачный фон вместо синего квадрата по умолчанию
    и мягкая красная подсветка при наведении.
  -->
  <Style
    x:Key="TabCloseButton"
    BasedOn="{StaticResource IssueRowCloseButton}"
    TargetType="themes:ButtonIcon">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="MinHeight" Value="9" />
    <Setter Property="IconSize" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <Style
    x:Key="CloseButton"
    BasedOn="{StaticResource OverlayIconButton}"
    TargetType="themes:ButtonIcon">
    <Style.Setters>
      <Setter Property="IconPath" Value="{StaticResource IconXClose}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style.Setters>
  </Style>

  <Style
    x:Key="ChangeFieldButton"
    BasedOn="{StaticResource RoundedButtonStyle}"
    TargetType="Button">
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Static system:String.Empty}">
        <Setter Property="Background" Value="{StaticResource SpBrush.Inset}" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Background" Value="{StaticResource SpBrush.Inset}" />
      </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Path=Value.isRequired}" Value="True" />
          <Condition Binding="{Binding Path=Value.display}" Value="{x:Static system:String.Empty}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFE8C4C4" />
        <Setter Property="Foreground" Value="{StaticResource SpBrush.Destructive}" />
        <Setter Property="ToolTip" Value="Required Field" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Path=Value.isRequired}" Value="True" />
          <Condition Binding="{Binding Path=Value.display}" Value="{x:Null}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFE8C4C4" />
        <Setter Property="Foreground" Value="{StaticResource SpBrush.Destructive}" />
        <Setter Property="ToolTip" Value="Required Field" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
