<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:themes="clr-namespace:Bcfier.Themes">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="{x:Type themes:TextPlaceholder}" TargetType="{x:Type themes:TextPlaceholder}" BasedOn="{StaticResource SpTextBox}">
    <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Placeholder" Value="Search" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource SpBrush.Muted}" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type themes:TextPlaceholder}">
          <Border
            x:Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource SpRadius.Control}"
            SnapsToDevicePixels="True">
            <Grid>
              <!-- Padding только на Border: иначе TextBoxView снова сдвигает каретку вправо -->
              <ScrollViewer
                x:Name="PART_ContentHost"
                Margin="0" />
              <TextBlock
                x:Name="Placeholder"
                Margin="0"
                Padding="{StaticResource SpSpace.TextBoxViewInset}"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                FontWeight="{TemplateBinding FontWeight}"
                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlaceholderColor}"
                IsHitTestVisible="False"
                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Placeholder}"
                TextWrapping="{TemplateBinding TextWrapping}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
              <Setter Property="Cursor" Value="IBeam" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
              <Setter TargetName="Border" Property="Background" Value="#FFF7FAFD" />
            </Trigger>
            <Trigger Property="HasText" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SpBrush.Inset}" />
              <Setter Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type themes:LabelSelectable}" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBoxBase}">
          <Border
            Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderThickness="0"
            SnapsToDevicePixels="True">
            <ScrollViewer
              x:Name="PART_ContentHost"
              Margin="0"
              Focusable="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ButtonIcon: по умолчанию neo; IsVertical — шапка с градиентом SP -->
  <Style
    x:Key="{x:Type themes:ButtonIcon}"
    BasedOn="{StaticResource RoundedButtonIconStyle}"
    TargetType="{x:Type themes:ButtonIcon}">
    <Style.Triggers>
      <Trigger Property="IsVertical" Value="True">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type themes:ButtonIcon}">
              <Border
                Name="ButtonBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderThickness="0"
                CornerRadius="{StaticResource SpRadius.Control}"
                SnapsToDevicePixels="True">
                <StackPanel Margin="2,0" Orientation="Vertical">
                  <Path
                    Name="Icon"
                    Width="{Binding Path=IconSizeVertical, RelativeSource={RelativeSource TemplatedParent}}"
                    Height="{Binding Path=IconSizeVertical, RelativeSource={RelativeSource TemplatedParent}}"
                    Margin="{Binding Path=IconMarginVertical, RelativeSource={RelativeSource TemplatedParent}}"
                    HorizontalAlignment="Center"
                    Data="{TemplateBinding IconPath}"
                    Fill="{TemplateBinding IconColor}"
                    Stretch="Uniform" />
                  <TextBlock
                    x:Name="MyContentPresenter"
                    MaxWidth="120"
                    HorizontalAlignment="Center"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Text="{TemplateBinding Content}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SpBrush.Accent}" />
                  <Setter TargetName="Icon" Property="Fill" Value="{StaticResource SpBrush.OnPrimary}" />
                  <Setter TargetName="MyContentPresenter" Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SpBrush.AccentDeep}" />
                  <Setter TargetName="Icon" Property="Fill" Value="{StaticResource SpBrush.OnPrimary}" />
                  <Setter TargetName="MyContentPresenter" Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="MyContentPresenter" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledIconColor}" />
                  <Setter TargetName="Icon" Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledIconColor}" />
                </Trigger>
                <Trigger Property="HasContent" Value="False">
                  <Setter TargetName="MyContentPresenter" Property="Visibility" Value="Collapsed" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
