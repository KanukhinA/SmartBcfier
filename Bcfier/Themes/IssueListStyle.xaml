<ResourceDictionary
  x:Class="Bcfier.Themes.IssueListStyle"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:themes="clr-namespace:Bcfier.Themes"
  xmlns:src="clr-namespace:Bcfier.Data.ValueConverters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <src:HasCoordinatesConverter x:Key="HasCoordinatesConverter" />
  <Style x:Key="IssueListStyle" TargetType="{x:Type ListViewItem}">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1.5"
            CornerRadius="5"
            SnapsToDevicePixels="true"
            themes:SpWindowChrome.ClipRadius="5">
            <Grid>
              <Border
                x:Name="Accent"
                Width="3"
                Margin="-4,1,0,1"
                HorizontalAlignment="Left"
                Background="Transparent"
                CornerRadius="2" />
              <ContentPresenter Margin="4,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Замечание без координат камеры (не привязано к 3D-виду) — мягкая пастельная обводка -->
            <DataTrigger Binding="{Binding Viewpoints, Converter={StaticResource HasCoordinatesConverter}}" Value="False">
              <Setter TargetName="Border" Property="BorderBrush" Value="#C9B98A" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#14005E96" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#33005E96" />
            </Trigger>
            <Trigger Property="IsSelected" Value="true">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SpRowSelectedBrush}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SpBrush.Primary}" />
              <Setter TargetName="Accent" Property="Background" Value="{StaticResource SpBrush.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListViewTheme" TargetType="ListView">
    <Setter Property="SnapsToDevicePixels" Value="true" />
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="true" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListView">
          <Border
            Name="Border"
            Padding="0"
            Background="{TemplateBinding Background}"
            BorderThickness="0"
            CornerRadius="0">
            <ScrollViewer Margin="0" Focusable="false">
              <StackPanel Margin="0" IsItemsHost="True" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
