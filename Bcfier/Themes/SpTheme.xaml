  <Style TargetType="ListView">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="{StaticResource SpBrush.BorderSubtle}" />
    <Setter Property="Width" Value="3" />
  </Style>

  <!-- Chrome окна SP: скругление без тени на outer (иначе ресайз мёртв) -->
  <Style x:Key="SpSettingsChromeOuter" TargetType="Border">
    <!-- alpha=1, но цвет как у surface (чтобы при рассечении клипом не вылезали чёрные полосы) -->
    <Setter Property="Background" Value="#01E4E8EF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpRadius.Window}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="SpSettingsChrome" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SpBrush.Surface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpRadius.Window}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{StaticResource SpEffect.Window}" />
  </Style>

  <Style x:Key="SpSettingsHeader" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SpBrush.HeaderGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpRadius.WindowTop}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="Effect" Value="{StaticResource SpEffect.Header}" />
  </Style>

  <Style x:Key="SpSettingsHeaderTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Arial" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="SpSettingsToolBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SpBrush.Card}" />
    <Setter Property="CornerRadius" Value="{StaticResource SpRadius.Card}" />
    <Setter Property="Padding" Value="{StaticResource SpSpace.ToolBarPadding}" />
    <Setter Property="Margin" Value="{StaticResource SpSpace.SectionMargin}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Компактная верхняя шапка главного окна (иконки + подписи) -->
  <Style x:Key="SpMainMenuToolBar" TargetType="Border" BasedOn="{StaticResource SpSettingsToolBar}">
    <Setter Property="Padding" Value="{StaticResource SpSpace.MainMenuPadding}" />
  </Style>

  <!-- Footer — те же боковые inset, что у body -->
  <Style x:Key="SpSettingsFooter" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SpBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{StaticResource SpSpace.FooterInset}" />
    <Setter Property="CornerRadius" Value="{StaticResource SpRadius.WindowBottom}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="SpSettingsSectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Margin" Value="{StaticResource SpSpace.FieldGap}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SpSettingsSectionTitleRule" TargetType="Border">
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="{StaticResource SpSpace.FieldGap}" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{StaticResource SpBrush.Inset}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{StaticResource SpEffect.NeoRaisedSoft}" />
  </Style>

  <Style x:Key="SpSettingsBodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SpSettingsMutedText" TargetType="TextBlock" BasedOn="{StaticResource SpSettingsBodyText}">
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Muted}" />
  </Style>

  <!-- Alias: те же ghost-поля, что и SpTextBox (единая логика) -->
  <Style x:Key="SpSettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource SpTextBox}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style x:Key="SpSettingsPasswordBox" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource SpBrush.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource SpRadius.Control}"
            SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Inset}" />
              <Setter Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpFilterSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SpSettingsTextBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource SpRadius.Control}"
            SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}">
              <TextBlock
                x:Name="Watermark"
                Margin="0"
                Padding="{StaticResource SpSpace.TextBoxViewInset}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                FontWeight="{TemplateBinding FontWeight}"
                Foreground="{StaticResource SpBrush.Muted}"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Text="Поиск"
                Visibility="Collapsed" />
              <ScrollViewer
                x:Name="PART_ContentHost"
                Margin="0"
                VerticalAlignment="Center"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                SnapsToDevicePixels="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
              <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Inset}" />
              <Setter Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpSettingsHeaderClose" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Bd"
            Background="Transparent"
            CornerRadius="4"
            SnapsToDevicePixels="True">
            <Path
              x:Name="Glyph"
              Width="10"
              Height="10"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="M 1,1 L 9,9 M 9,1 L 1,9"
              Stretch="None"
              Stroke="#F0FFFFFF"
              StrokeEndLineCap="Round"
              StrokeStartLineCap="Round"
              StrokeThickness="1.4" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#22000000" />
              <Setter TargetName="Glyph" Property="Stroke" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#33000000" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
