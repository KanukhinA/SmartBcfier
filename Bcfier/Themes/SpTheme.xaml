            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Surface}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.BorderSubtle}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.Primary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
