                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.ButtonSolidHover}" />
