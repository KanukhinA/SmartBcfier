<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
  xmlns:themes="clr-namespace:Bcfier.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ScrollViewer.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Как в SP: Roboto из Fonts/, запасной Segoe UI; заголовок шапки — Arial -->
  <FontFamily x:Key="SpFont.Ui">pack://application:,,,/Bcfier;component/Fonts/#Roboto, Segoe UI</FontFamily>
  <FontFamily x:Key="SpFont.Title">Arial</FontFamily>
  <FontFamily x:Key="SpFontBody">pack://application:,,,/Bcfier;component/Fonts/#Roboto, Segoe UI</FontFamily>
  <FontFamily x:Key="SpFontTitle">Arial</FontFamily>

  <CornerRadius x:Key="SpRadius.Window">10</CornerRadius>
  <CornerRadius x:Key="SpRadius.WindowTop">10,10,0,0</CornerRadius>
  <CornerRadius x:Key="SpRadius.WindowBottom">0,0,10,10</CornerRadius>
  <CornerRadius x:Key="SpRadius.Card">8</CornerRadius>
  <CornerRadius x:Key="SpRadius.Control">6</CornerRadius>
  <CornerRadius x:Key="SpRadius.Button">6</CornerRadius>
  <CornerRadius x:Key="SpRadius.ButtonInner">5</CornerRadius>
  <Thickness x:Key="SpSpace.Xs">4</Thickness>
  <Thickness x:Key="SpSpace.Sm">6</Thickness>
  <Thickness x:Key="SpSpace.Md">8</Thickness>
  <Thickness x:Key="SpSpace.HeaderInset">14,0,14,0</Thickness>
  <Thickness x:Key="SpSpace.ContentInset">14,8,14,8</Thickness>
  <Thickness x:Key="SpSpace.ContentInsetTop">14,8,14,0</Thickness>
  <Thickness x:Key="SpSpace.FooterInset">14,8,14,8</Thickness>
  <Thickness x:Key="SpSpace.SectionMargin">8,1,8,8</Thickness>
  <Thickness x:Key="SpSpace.ToolBarPadding">12,8</Thickness>
  <Thickness x:Key="SpSpace.MainMenuPadding">6,4</Thickness>
  <Thickness x:Key="SpSpace.FieldGap">0,0,0,6</Thickness>
  <Thickness x:Key="SpSpace.RowGap">0,4,0,0</Thickness>
  <Thickness x:Key="SpSpace.StackGap">0,6,0,0</Thickness>
  <!-- Внутренний Margin TextBoxView (каретка BiDi): подсказка должна начинаться там же, где ввод -->
  <Thickness x:Key="SpSpace.TextBoxViewInset">2,0,2,0</Thickness>

  <DropShadowEffect
    x:Key="SpEffect.NeoRaised"
    BlurRadius="12"
    Direction="270"
    Opacity="0.14"
    ShadowDepth="1"
    Color="{StaticResource SpColor.Shadow}" />
  <DropShadowEffect
    x:Key="SpEffect.NeoRaisedSoft"
    BlurRadius="6"
    Direction="270"
    Opacity="0.12"
    ShadowDepth="1"
    Color="{StaticResource SpColor.Shadow}" />
  <DropShadowEffect
    x:Key="SpEffect.NeoButton"
    BlurRadius="10"
    Direction="270"
    Opacity="0.18"
    ShadowDepth="2"
    Color="{StaticResource SpColor.Shadow}" />
  <DropShadowEffect
    x:Key="SpEffect.NeoButtonPressed"
    BlurRadius="2"
    Direction="135"
    Opacity="0.16"
    ShadowDepth="1"
    Color="{StaticResource SpColor.Shadow}" />
  <DropShadowEffect
    x:Key="SpEffect.NeoButtonSoft"
    BlurRadius="8"
    Direction="270"
    Opacity="0.14"
    ShadowDepth="1"
    Color="{StaticResource SpColor.Shadow}" />
  <DropShadowEffect
    x:Key="SpEffect.Header"
    BlurRadius="5"
    Direction="270"
    Opacity="0.12"
    ShadowDepth="1"
    Color="#FF000000" />
  <DropShadowEffect
    x:Key="SpEffect.Window"
    BlurRadius="14"
    Direction="270"
    Opacity="0.16"
    ShadowDepth="3"
    Color="#FF000000" />

  <!-- Кнопка SP Secondary: белая raised, hover Accent -->
  <Style x:Key="RoundedButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SpBrush.ButtonRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border
              x:Name="Shadow"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource SpRadius.Button}"
              Effect="{StaticResource SpEffect.NeoButtonSoft}" />
            <Border
              x:Name="Stroke"
              Background="{StaticResource SpBrush.Border}"
              CornerRadius="{StaticResource SpRadius.Button}"
              SnapsToDevicePixels="True">
              <Border
                x:Name="Bd"
                Margin="1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource SpRadius.ButtonInner}"
                SnapsToDevicePixels="True">
                <ContentPresenter
                  x:Name="Cp"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RecognizesAccessKey="True"
                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource SpEffect.NeoButtonPressed}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpSecondaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}" />

  <!-- Переключатель в стиле SP Secondary: та же скруглённая пилюля, подсветка Primary при IsChecked -->
  <Style x:Key="SpSecondaryToggleButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource SpBrush.ButtonRaised}" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border
              x:Name="Shadow"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource SpRadius.Button}"
              Effect="{StaticResource SpEffect.NeoButtonSoft}" />
            <Border
              x:Name="Stroke"
              Background="{StaticResource SpBrush.Border}"
              CornerRadius="{StaticResource SpRadius.Button}"
              SnapsToDevicePixels="True">
              <Border
                x:Name="Bd"
                Margin="1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource SpRadius.ButtonInner}"
                SnapsToDevicePixels="True">
                <ContentPresenter
                  x:Name="Cp"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RecognizesAccessKey="True"
                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource SpEffect.NeoButtonPressed}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.Primary}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.Primary}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Primary}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}" />

  <!-- Primary action: синяя solid, hover Accent -->
  <Style x:Key="SpAccentButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SpBrush.ButtonSolid}" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinWidth" Value="110" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border
              x:Name="Shadow"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource SpRadius.Button}"
              Effect="{StaticResource SpEffect.NeoButton}" />
            <Border
              x:Name="Stroke"
              Background="{StaticResource SpBrush.ButtonSolidEdge}"
              CornerRadius="{StaticResource SpRadius.Button}"
              SnapsToDevicePixels="True">
              <Border
                x:Name="Bd"
                Margin="1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource SpRadius.ButtonInner}"
                SnapsToDevicePixels="True">
                <ContentPresenter
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RecognizesAccessKey="True"
                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource SpEffect.NeoButtonPressed}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter Property="Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ButtonIcon: тот же neo, иконка слева -->
  <Style x:Key="RoundedButtonIconStyle" TargetType="themes:ButtonIcon" BasedOn="{StaticResource RoundedButtonStyle}">
    <Setter Property="IconColor" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="DisabledIconColor" Value="#995A6570" />
    <Setter Property="IconSize" Value="15" />
    <Setter Property="IconMargin" Value="0,0,6,0" />
    <Setter Property="IsVertical" Value="False" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="themes:ButtonIcon">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border
              x:Name="Shadow"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource SpRadius.Button}"
              Effect="{StaticResource SpEffect.NeoButtonSoft}" />
            <Border
              x:Name="Stroke"
              Background="{StaticResource SpBrush.Border}"
              CornerRadius="{StaticResource SpRadius.Button}"
              SnapsToDevicePixels="True">
              <Border
                x:Name="border"
                Margin="1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource SpRadius.ButtonInner}"
                SnapsToDevicePixels="True">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                  <Path
                    x:Name="Icon"
                    Width="{Binding IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                    Height="{Binding IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                    Margin="{Binding IconMargin, RelativeSource={RelativeSource TemplatedParent}}"
                    VerticalAlignment="Center"
                    Data="{TemplateBinding IconPath}"
                    Fill="{TemplateBinding IconColor}"
                    Stretch="Uniform"
                    SnapsToDevicePixels="True" />
                  <ContentPresenter
                    x:Name="content"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
                </StackPanel>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="border" Property="Background" Value="{StaticResource SpBrush.ButtonSolidHover}" />
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource SpBrush.OnPrimary}" />
              <Setter TargetName="content" Property="TextElement.Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shadow" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource SpEffect.NeoButtonPressed}" />
              <Setter TargetName="Stroke" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="border" Property="Background" Value="{StaticResource SpBrush.ButtonSolidPressed}" />
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource SpBrush.OnPrimary}" />
              <Setter TargetName="content" Property="TextElement.Foreground" Value="{StaticResource SpBrush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Icon" Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledIconColor}" />
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
              <Setter Property="IconMargin" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
  </Style>

  <!-- Поля ввода: в покое видна граница; при hover фон светлеет (белый). -->
  <Style x:Key="SpTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource SpBrush.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource SpRadius.Control}"
            SnapsToDevicePixels="True">
            <!-- Padding на Border, не на ScrollViewer — иначе двойной сдвиг каретки -->
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SpBrush.Inset}" />
              <Setter Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource SpTextBox}" />

  <Style x:Key="SpComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="MaxDropDownHeight" Value="200" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}" />
          <Setter Property="FontSize" Value="12.5" />
          <Setter Property="Foreground" Value="{StaticResource SpBrush.Foreground}" />
          <Setter Property="Padding" Value="8,4" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border
                  x:Name="Bd"
                  Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  SnapsToDevicePixels="True">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#1A005E96" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#22005E96" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton
              x:Name="ToggleButton"
              ClickMode="Press"
              Focusable="False"
              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border
                    x:Name="ToggleBd"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    CornerRadius="{StaticResource SpRadius.Control}"
                    SnapsToDevicePixels="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="1" Background="Transparent">
                        <Path
                          x:Name="Arrow"
                          Width="10"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 4,4 L 8,0"
                          Stretch="Uniform"
                          Stroke="{StaticResource SpBrush.Muted}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.5" />
                      </Border>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ToggleBd" Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
                      <Setter TargetName="ToggleBd" Property="Background" Value="{StaticResource SpBrush.Field}" />
                      <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource SpBrush.Primary}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="ToggleBd" Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
                      <Setter TargetName="ToggleBd" Property="Background" Value="{StaticResource SpBrush.Field}" />
                      <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource SpBrush.Primary}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter
              x:Name="ContentSite"
              Margin="7,3,26,3"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Content="{TemplateBinding SelectionBoxItem}"
              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
              IsHitTestVisible="False"
              RecognizesAccessKey="False"
              TextElement.FontFamily="{TemplateBinding FontFamily}"
              TextElement.FontSize="{TemplateBinding FontSize}"
              TextElement.Foreground="{TemplateBinding Foreground}" />
            <TextBox
              x:Name="PART_EditableTextBox"
              Margin="5,3,26,3"
              Padding="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              VerticalContentAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              CaretBrush="{StaticResource SpBrush.Primary}"
              Focusable="True"
              FontFamily="{TemplateBinding FontFamily}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{TemplateBinding Foreground}"
              IsReadOnly="{TemplateBinding IsReadOnly}"
              Visibility="Hidden" />
            <TextBlock
              x:Name="PlaceholderText"
              Margin="7,3,26,3"
              VerticalAlignment="Center"
              Foreground="{StaticResource SpBrush.Foreground}"
              IsHitTestVisible="False"
              Text="{TemplateBinding Tag}"
              TextTrimming="CharacterEllipsis"
              Visibility="Collapsed" />
            <Popup
              x:Name="PART_Popup"
              AllowsTransparency="True"
              Focusable="False"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              Placement="Bottom"
              PopupAnimation="None">
              <Border
                x:Name="DropDownBorder"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                Margin="0,2,0,0"
                Background="{StaticResource SpBrush.Field}"
                BorderBrush="{StaticResource SpBrush.NeoEdge}"
                BorderThickness="1"
                CornerRadius="{StaticResource SpRadius.Control}"
                SnapsToDevicePixels="True">
                <ScrollViewer
                  Margin="0,2"
                  CanContentScroll="False"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Border}" />
              <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource SpBrush.Focus}" />
              <Setter Property="Background" Value="{StaticResource SpBrush.Field}" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter Property="IsTabStop" Value="False" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEditable" Value="False" />
                <Condition Property="SelectedIndex" Value="-1" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEditable" Value="True" />
                <Condition Property="Text" Value="" />
                <Condition Property="IsKeyboardFocusWithin" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

