<Window x:Class="Bcfier.Revit.AddIssueRevit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:Loc.AddIssue}" SizeToContent="WidthAndHeight" MinWidth="440" MaxWidth="480"
        xmlns:ctr="clr-namespace:Bcfier.UserControls;assembly=Bcfier"
        xmlns:themes="clr-namespace:Bcfier.Themes;assembly=Bcfier"
        xmlns:loc="clr-namespace:Bcfier.Localization;assembly=Bcfier"
        Icon="pack://application:,,,/Bcfier;component/Assets/SP_BCFier32.png"
        FontFamily="{DynamicResource SpFont.Ui}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/SpTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/ButtonStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Bcfier;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource SpComboBox}">
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="8" Background="{StaticResource SpBrush.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <themes:TextPlaceholder Height="28" FontSize="16" Grid.Row="0" Placeholder="{x:Static loc:Loc.IssueTitleRequired}" Name="TitleBox" HorizontalAlignment="Stretch" Margin="0,0,0,10" />

        <Border Grid.Row="1" Style="{StaticResource SpSettingsToolBar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SpSettingsSectionTitle}" Text="{x:Static loc:Loc.SnapshotsEditor}" />
                    <Border Style="{StaticResource SpSettingsSectionTitleRule}" />
                </StackPanel>
                <Border Grid.Row="1"
                        Background="{StaticResource SpBrush.Card}"
                        BorderBrush="{StaticResource SpBrush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SpRadius.Card}"
                        Padding="6">
                    <Image MaxWidth="400" MaxHeight="220" Stretch="Uniform"
                           HorizontalAlignment="Left" Source="Assets/snapshot.png" x:Name="SnapshotImg">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.5" Direction="316" ShadowDepth="1"/>
                        </Image.Effect>
                    </Image>
                </Border>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,0">
                    <Button Content="{x:Static loc:Loc.AnnotateSnapshot}" Style="{StaticResource SpSecondaryButton}" HorizontalAlignment="Left" Margin="0,0,6,0" VerticalAlignment="Top" Click="EditSnapshot_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource SpSettingsToolBar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SpSettingsSectionTitle}" Text="{x:Static loc:Loc.SnapshotsEditor}" />
                    <Border Style="{StaticResource SpSettingsSectionTitleRule}" />
                </StackPanel>
                <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" Style="{StaticResource CompactComboBoxStyle}" x:Name="comboVisuals" Tag="{x:Static loc:Loc.SnapshotsEditor}" SelectionChanged="comboVisuals_SelectionChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Margin="0,4,0,0" Style="{StaticResource SpSettingsToolBar}">
            <Expander Header="{x:Static loc:Loc.AttachElements}" VerticalAlignment="Top">
                <Grid Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <RadioButton GroupName="elemList" Content="{x:Static loc:Loc.OnlyVisible}" Name="all" Grid.Row="0" />
                    <RadioButton GroupName="elemList" Content="{x:Static loc:Loc.OnlySelected}" Name="selected" IsChecked="True" Grid.Row="1" />
                    <RadioButton GroupName="elemList" Content="{x:Static loc:Loc.None}" Name="none" Grid.Row="2" />
                </Grid>
            </Expander>
        </Border>
        <Border Grid.Row="6" Margin="0,4,0,0" Style="{StaticResource SpSettingsToolBar}">
            <Expander Header="{x:Static loc:Loc.LoadLocalImage}" VerticalAlignment="Top">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SpSettingsBodyText}" Text="{x:Static loc:Loc.SelectLocalImage}" />
                    <Button Margin="0,6,0,0" Height="24" Grid.Row="1" VerticalAlignment="Bottom" MinWidth="90" Padding="10,2" Style="{StaticResource SpSecondaryButton}" Content="{x:Static loc:Loc.Browse}" HorizontalAlignment="Left" Click="Button_LoadImage"/>
                    <Label x:Name="PathLabel" Content="{x:Static loc:Loc.Path}" Margin="0,6,0,0" Grid.Row="2" Foreground="{StaticResource SpBrush.Muted}" Padding="0" />
                </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="7" Margin="0,4,0,0" Style="{StaticResource SpSettingsToolBar}">
            <Expander Header="{x:Static loc:Loc.CommentOptional}" IsExpanded="True">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <DockPanel HorizontalAlignment="Stretch" Grid.Row="0" Name="commentStatusBox">
                        <ComboBox Name="comboStatuses" Margin="0,0,6,0" Width="100" Style="{StaticResource CompactComboBoxStyle}" Tag="{x:Static loc:Loc.Status}"/>
                        <themes:TextPlaceholder MaxLength="20" Placeholder="{x:Static loc:Loc.VerbalStatusOptional}" Name="VerbalStatus" HorizontalAlignment="Stretch" />
                    </DockPanel>
                    <TextBox x:Name="CommentBox" Grid.Row="1" Margin="0,6,0,0" Height="70" Style="{StaticResource SpSettingsTextBox}" HorizontalAlignment="Stretch" TextWrapping="Wrap" />
                </Grid>
            </Expander>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static loc:Loc.Add}" Style="{StaticResource SpAccentButton}" IsDefault="True" Margin="0,0,6,0" MinWidth="100" Padding="10,4" Click="Button_OK"/>
            <Button Content="{x:Static loc:Loc.Cancel}" Style="{StaticResource SpSecondaryButton}" Margin="0" MinWidth="100" Padding="10,4" Click="Button_Cancel"/>
        </StackPanel>
    </Grid>
</Window>
