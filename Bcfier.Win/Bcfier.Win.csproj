<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatAsLocalProperty>Platform</TreatAsLocalProperty>
    <Platform Condition="'$(Platform)' == 'Any CPU' Or '$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Bcfier.Win</RootNamespace>
    <AssemblyName>BCFier.Win</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Один TFM: не зависит от года Revit -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net48</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\dist\Win\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyVersionInfo.cs" Link="AssemblyVersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Viewer всегда на net48/Win. При сборке solution как R2025/R2026
      SetConfiguration=$(Configuration) тянул Bcfier net48 в режиме skip
      (активный TFM = net8) → CS0103 на все типы Bcfier.
    -->
    <ProjectReference Include="..\Bcfier\Bcfier.csproj">
      <SetConfiguration>Configuration=Win</SetConfiguration>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <SetTargetFramework>TargetFramework=net48</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\SP_BCFier32.png" />
  </ItemGroup>
</Project>
